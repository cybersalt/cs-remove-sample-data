<?xml version="1.0" encoding="utf-8"?>
<!--
    Fallback update feed for sites still polling this GitHub-hosted URL.

    From v1.0.1 onwards the manifest points at the cs-Release-Manager-served
    endpoint at https://www.cybersalt.com/index.php?option=com_csreleasemanager&task=api.updatexml&format=raw&element=com_removesampledata
    — that's the authoritative source. This static file remains so that any
    site running v1.0.0 (whose manifest still points here) can find and
    install v1.0.1, after which it'll switch to cs-Release-Manager
    automatically. Keep this file in sync with the latest version published
    via cs-Release-Manager.
-->
<updates>
    <update>
        <name>Cybersalt Remove Sample Data</name>
        <description>Remove the items installed by Joomla's Blog and Multilingual sample data plugins, with preview, per-item opt-out, type/title/status filters, and a full activity log.</description>
        <element>com_removesampledata</element>
        <type>component</type>
        <version>1.1.0</version>
        <infourl title="Remove Sample Data">https://github.com/cybersalt/cs-remove-sample-data</infourl>
        <downloads>
            <downloadurl type="full" format="zip">https://github.com/cybersalt/cs-remove-sample-data/releases/download/v1.1.0/com_removesampledata_v1.1.0.zip</downloadurl>
        </downloads>
        <targetplatform name="joomla" version="5\.[0-9]+|6\.[0-9]+" />
        <php_minimum>8.1</php_minimum>
        <maintainer>Cybersalt</maintainer>
        <maintainerurl>https://cybersalt.com</maintainerurl>
        <changelogurl>https://raw.githubusercontent.com/cybersalt/cs-remove-sample-data/main/changelog.xml</changelogurl>
    </update>
</updates>
