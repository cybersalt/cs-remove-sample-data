<?xml version="1.0" encoding="utf-8"?>
<config>
    <fieldset name="defaults"
              label="COM_REMOVESAMPLEDATA_OPTIONS_DEFAULTS_LABEL"
              description="COM_REMOVESAMPLEDATA_OPTIONS_DEFAULTS_DESC">
        <field name="log_retention_days"
               type="number"
               label="COM_REMOVESAMPLEDATA_OPTIONS_LOG_RETENTION_LABEL"
               description="COM_REMOVESAMPLEDATA_OPTIONS_LOG_RETENTION_DESC"
               default="90"
               min="1"
               max="3650" />
        <field name="restore_main_menu_module"
               type="radio"
               layout="joomla.form.field.radio.switcher"
               label="COM_REMOVESAMPLEDATA_OPTIONS_RESTORE_MAIN_MENU_LABEL"
               description="COM_REMOVESAMPLEDATA_OPTIONS_RESTORE_MAIN_MENU_DESC"
               default="1">
            <option value="1">JYES</option>
            <option value="0">JNO</option>
        </field>
    </fieldset>

    <fieldset name="permissions"
              label="JCONFIG_PERMISSIONS_LABEL"
              description="JCONFIG_PERMISSIONS_DESC">
        <field name="rules"
               type="rules"
               label="JCONFIG_PERMISSIONS_LABEL"
               filter="rules"
               validate="rules"
               component="com_removesampledata"
               section="component" />
    </fieldset>
</config>
